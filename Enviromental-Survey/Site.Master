<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Enviromental_Surveys.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Environmental Survey</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">

    <!-- Icon Fonts -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries CSS -->
    <link href="<%= ResolveUrl("~/assets/lib/animate/animate.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/assets/lib/lightbox/css/lightbox.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/assets/lib/owlcarousel/assets/owl.carousel.min.css") %>" rel="stylesheet" />

    <!-- Bootstrap + Template CSS -->
    <link href="<%= ResolveUrl("~/assets/css/bootstrap.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/assets/css/style.css") %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Spinner Start -->
        <div id="spinner"
             class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->

        <!-- Navbar -->
        <div class="container-fluid position-relative p-0">
            <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
                <a href="Home.aspx" class="navbar-brand p-0">
                    <h1 class="text-primary"><i class="fas fa-leaf"></i>Environmental Survey</h1>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav ms-auto py-0">
                        <a href="Home.aspx" class="nav-item nav-link active">Home</a>
                        <a href="survey-board.aspx" class="nav-item nav-link">Survey Board</a>
                        <a href="FAQ.aspx" class="nav-item nav-link">FAQs</a>
                        <a href="support.aspx" class="nav-item nav-link">Support</a>
                    </div>
                </div>
                <a href="Account/register.aspx" class="btn btn-primary rounded-pill py-2 px-3 my-2 my-lg-0 flex-shrink-0">
                    <i class="fa fa-user text-light me-2"></i>Register
                </a>
                <a href="Account/login.aspx" class="btn btn-primary rounded-pill py-2 px-3 my-2 my-lg-0 ms-1 flex-shrink-0">
                    <i class="fa fa-sign-in-alt text-light me-2"></i>Login
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>

        <!-- Back to Top -->
        <a href="#" class="btn btn-primary btn-lg-square rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>

 <!-- Footer Start -->
<div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
       <div class="container py-5 border-start-0 border-end-0"
            style="border: 1px solid grey;">
        <div class="row g-5">
            <!-- Column 1: Logo + Description -->
            <div class="col-md-6 col-lg-6 col-xl-4">
                <div class="footer-item">
                    <a href="Home.aspx" class="p-0">
                        <h4 class="text-white"><i class="fas fa-leaf me-3"></i>Environmental Survey</h4>
                    </a>
                    <p class="mb-4">
                        An online portal for students and faculty to participate in surveys, spread awareness, and protect the environment.
                    </p>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div class="col-md-6 col-lg-6 col-xl-2">
                <div class="footer-item">
                    <h4 class="text-white mb-4">Quick Links</h4>
                    <a href="Home.aspx"><i class="fas fa-angle-right me-2"></i>Home</a>
                    <a href="survey-board.aspx"><i class="fas fa-angle-right me-2"></i>Survey Board</a>
                    <a href="FAQ.aspx"><i class="fas fa-angle-right me-2"></i>FAQs</a>
                    <a href="support.aspx"><i class="fas fa-angle-right me-2"></i>Support</a>
                </div>
            </div>

            <!-- Column 3: Support -->
            <div class="col-md-6 col-lg-6 col-xl-3">
                <div class="footer-item">
                    <h4 class="text-white mb-4">Support</h4>
                    <a href="#"><i class="fas fa-angle-right me-2"></i>Privacy Policy</a>
                    <a href="#"><i class="fas fa-angle-right me-2"></i>Terms & Conditions</a>
                    <a href="support.aspx"><i class="fas fa-angle-right me-2"></i>Support</a>
                    <a href="FAQ.aspx"><i class="fas fa-angle-right me-2"></i>FAQs</a>
                </div>
            </div>

            <!-- Column 4: Contact Info + Social -->
            <div class="col-md-6 col-lg-6 col-xl-3">
                <div class="footer-item">
                    <h4 class="text-white mb-4">Contact Info</h4>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-map-marker-alt text-primary me-3"></i>
                        <p class="text-white mb-0">123 Site Center</p>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-envelope text-primary me-3"></i>
                        <p class="text-white mb-0">admin@surveyportal.com</p>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-phone-alt text-primary me-3"></i>
                        <p class="text-white mb-0">(+012) 3456 7890</p>
                    </div>
                    <div class="d-flex">
                        <a class="btn btn-primary btn-sm-square rounded-circle me-3" href="https://www.facebook.com/">
                            <i class="fab fa-facebook-f text-white"></i>
                        </a>
                        <a class="btn btn-primary btn-sm-square rounded-circle me-3" href="https://x.com/">
                            <i class="fab fa-twitter text-white"></i>
                        </a>
                        <a class="btn btn-primary btn-sm-square rounded-circle me-3" href="https://www.instagram.com/">
                            <i class="fab fa-instagram text-white"></i>
                        </a>
                        <a class="btn btn-primary btn-sm-square rounded-circle me-0" href="https://pk.linkedin.com/">
                            <i class="fab fa-linkedin-in text-white"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Copyright -->
    <div class="container text-center mt-4">
        <p class="mb-0 text-white">&copy; 2025 Environmental Survey. All Rights Reserved.</p>
    </div>
</div>
<!-- Footer End -->


    </form>

    <!-- JS Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("~/assets/lib/wow/wow.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/lib/easing/easing.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/lib/waypoints/waypoints.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/lib/counterup/counterup.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/lib/lightbox/js/lightbox.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/lib/owlcarousel/owl.carousel.min.js") %>"></script>

    <!-- Template JS -->
    <script src="<%= ResolveUrl("~/assets/js/main.js") %>"></script>

    <!-- Spinner Hide Script -->
    <script type="text/javascript">
        window.addEventListener('load', function () {
            var spinner = document.getElementById('spinner');
            if (spinner) {
                spinner.classList.remove('show');
            }
        });
    </script>

</body>
</html>  
